[Unit]
Description=Ink — evening catch-up reminder over Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/apps/challengebot
ExecStart=/usr/bin/python3 %h/apps/challengebot/challengebot.py evening
StandardOutput=append:%h/apps/challengebot/challengebot.log
StandardError=append:%h/apps/challengebot/challengebot.log
